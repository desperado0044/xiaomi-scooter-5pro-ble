<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pre-Android 12 (API < 31, e.g. Fire OS 9 tablets): the classic Bluetooth permissions -
         without these, BluetoothDevice.connectGatt() throws a binder exception before even
         attempting a connection, since BLUETOOTH_SCAN/BLUETOOTH_CONNECT below don't exist yet. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: needed to show the optional insurance-plate reminders. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the "Download update" button open the system installer (the user still confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Lets the documents screen find the phone's default camera app (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ScooterClient"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- scooterre://import?code=<export code> - lets a saved-device export code be
                 imported via a plain link/deep-link tap (e.g. from a messaging app, or "adb shell
                 am start -d ...") instead of manually pasting it into the import field - the exact
                 same DeviceRegistry/SecureStore write the in-app paste field triggers, just a
                 different entry point into it.
                 scooterre://login?action=qr - opens the QR cloud-login screen the same way tapping
                 the "QR-Login" button would, for devices where adb can route an Intent (am start)
                 but not simulate a tap (INJECT_EVENTS blocked). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="scooterre" android:host="import" />
                <data android:scheme="scooterre" android:host="login" />
            </intent-filter>
        </activity>

        <!-- Result of an app update installed through the "Download update" button. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- The "new insurance applied for" button of the insurance-plate reminder notification. -->
        <receiver
            android:name=".reminder.InsuranceActionReceiver"
            android:exported="false" />

        <!-- Hands an export bundle to the share sheet (chat apps etc.) without a storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".widget.ScooterWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scooter_widget_info" />
        </receiver>
    </application>
</manifest>
