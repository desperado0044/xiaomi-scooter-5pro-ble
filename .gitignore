# Only android-app/ is tracked in this repo - reference/, ghidra/, hooks/ and secrets/
# are intentionally excluded (see README for why).
/reference/
/ghidra/
/hooks/
/docs/telemetry.txt

# Android / Gradle
android-app/**/build/
android-app/.gradle/
android-app/.kotlin/
android-app/local.properties
android-app/**/*.apk
android-app/**/*.keystore
android-app/.idea/
android-app/**/.cxx/

# Never commit secrets
**/secrets/
**/*.hex
**/ltmk*

# Signing material (the real key lives in ~/.scooter-signing, outside the repo)
**/*.p12
**/*.jks
**/keystore.properties
